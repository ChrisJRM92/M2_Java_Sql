<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="TRACE">

    <Appenders>
        <File name="FileLogger" fileName="queridoDiario.log">
            <PatternLayout>
                <Pattern>%d [%t] %-5level %c - %msg%n</Pattern>
            </PatternLayout>
        </File>
    </Appenders>

    <Loggers>
        <Root level="trace">
            <AppenderRef ref="FileLogger"/>
        </Root>
    </Loggers>

</Configuration>